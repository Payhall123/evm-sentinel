# Copy to .env for local development, or add these in Vercel Project Settings.
# Never commit the real .env.

# --- Core ---
# DATABASE_URL: pooled connection (use the Neon/Supabase pooler on Vercel)
# DIRECT_URL:   direct connection, used by `prisma migrate deploy`
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/evmsentinel?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/evmsentinel?schema=public"
SESSION_SECRET="generate-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Public HTTPS origin of this deployment. Used for webhooks and unsubscribe links.
APP_BASE_URL="https://your-app.vercel.app"
UNSUBSCRIBE_SECRET="generate-a-long-random-string"
UNSUBSCRIBE_BASE_URL="https://your-app.vercel.app"

# --- Vercel cron ---
# Vercel sends this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate-a-long-random-string"
# Optional tuning. Defaults are serverless-friendly when VERCEL=1.
# DISPATCH_BATCH_SIZE="25"
# DISPATCH_TIME_BUDGET_MS="45000"
# DISPATCH_MAX_CAMPAIGNS_PER_TICK="1"

# --- Postal (legacy/self-hosted) ---
POSTAL_URL="https://mail.example.com"
POSTAL_ADMIN_EMAIL="admin@example.com"
POSTAL_ADMIN_PASSWORD="change-me"
# POSTAL_SMTP_HOSTNAME=""
# POSTAL_SMTP_PORT="25"

# --- Devner (Gmail-backed relay) ---
DEVNER_API_URL="https://your-devner.example.com"
DEVNER_API_KEY=""

# --- HTTP email providers ---
ELASTICEMAIL_API_KEY=""
RESEND_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_API_BASE=""
BIRD_API_KEY=""

# --- Amazon SES ---
SES_WEBHOOK_SECRET=""
SES_SNS_TOPIC_ARN=""

# --- Cloudflare Email Service (no SMTP) ---
# Inbound Email Routing additionally needs:
# Zone: Read, Zone Settings: Write, Email Routing Rules: Edit,
# Email Routing Addresses: Edit.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# --- Optional ---
GROQ_API_KEYS=""
